# Apple Code Signing & Notarization (macOS)
# Kopieer naar .env en vul in. Commit .env NOOIT.

# Je Apple ID (e-mail)
APPLE_ID=your-apple-id@example.com

# App-specifiek wachtwoord (appleid.apple.com → Sign-In and Security → App-Specific Passwords)
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team ID (10 tekens, developer.apple.com → Membership)
APPLE_TEAM_ID=XXXXXXXXXX

# Exacte certificaatnaam uit Sleutelhangertoegang (zoals in Keychain getoond, vaak met "Developer ID Application:")
CSC_NAME="Developer ID Application: Jouw naam (XXXXXXXXXX)"

# Optioneel: Windows code signing (alleen op Windows-buildmachine)
# CSC_LINK=pad/naar/certificaat.pfx
# CSC_KEY_PASSWORD=jouw-pfx-wachtwoord
